SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
# Neshan (set in Project Settings → Secrets, never commit values)
# NESHAN_MAP_KEY: browser web-map key, restrict it to your domains in the Neshan panel
# NESHAN_SERVICE_KEY: server-only key for routing (v4/direction), reverse geocoding and search
